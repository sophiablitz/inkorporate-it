<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Android merges this into app/src/main/AndroidManifest.xml
  for debug builds, so only they get the plain ws:// exception in
  res/xml/network_security_config.xml. Release builds never see it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
